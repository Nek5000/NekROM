#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

genmap << EOF
ann
0.1
EOF
# genmap may generate a binary ann.ma2 alongside ann.map (tool/version dependent).
# Do not fabricate ann.ma2 by copying ann.map: Nek5000 expects .ma2 to be binary.
if [ -f ann.map ] && [ -f ann.ma2 ] && cmp -s ann.map ann.ma2; then
    echo "warning: ann.ma2 is identical to ann.map; removing invalid ann.ma2" >&2
    rm -f ann.ma2
fi

np="${1:-1}"
casename="ann"
usr_file="${casename}"
logfile="${casename}.log.${np}"

makerom "$usr_file"

echo 'running Nek5000 FOM calculation...'
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' "$casename" "$script_dir" > SESSION.NAME
    ./nek5000 > "$logfile"
else
    neklmpi "$casename" "$np"
fi

mkdir -p snaps
if compgen -G "*${casename}0.f*" > /dev/null; then
    mv *${casename}0.f* snaps
fi
if [ -f "$logfile" ]; then
    mv "$logfile" snaps
else
    echo "warning: logfile '$logfile' not found; skipping move to snaps/" >&2
fi

shopt -s nullglob
snap_files=(snaps/*${casename}0.f*)
shopt -u nullglob
if ((${#snap_files[@]} == 0)); then
    echo "error: no snapshot files found matching snaps/*${casename}0.f*" >&2
    exit 1
fi

printf '%s\n' "${snap_files[@]}" | LC_ALL=C sort -r > file.list
printf '%s\n' "${snap_files[@]}" | LC_ALL=C sort -r > fom_avg.list
echo done >> fom_avg.list

echo 'done with FOM, exiting...'
