#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

np="${1:-4}"
eps0=1.6
eps1=2.6
deps=0.25

echo "run_fom start"

# The case initializes from useric; keep a local seed file only if one already exists.

genmap << Z
rb
0.1
Z

for i in {0..4}; do
    eps=$(echo "$eps0 + $i * $deps" | bc -l)
    echo "run $i: eps=$eps"
    ./run_fom_helper "$i" "$eps" "$np"
done

echo "run_fom done"
