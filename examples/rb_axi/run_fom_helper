#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

i="$1"
eps="$2"
np="$3"
archive_root="${ARCHIVE_ROOT:-${TMPDIR:-/tmp}/rb_axi_archive}"

mkdir -p "$archive_root"

if compgen -G "rb0.f*" > /dev/null; then
    mv rb0.f* "$archive_root"/
fi

if [ -d "fom${i}" ]; then
    mv "fom${i}" "$archive_root/fom${i}_$(date +%s)"
fi

echo "$eps" > eps
if [ ! -x nek5000 ]; then
    makenek rb_fom
fi
nekmpi rb "$np"

mkdir -p "fom$i"
mv eps "fom${i}"/
mv rb0.f* "fom${i}"/
mv "rb.log.$np" "fom${i}"/logfile
grep ' nus' "fom${i}"/logfile > "fom${i}"/nus.dat
