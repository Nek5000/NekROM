[general]
mode = on
field = vt
nb = 40
ns = 24
# Note: this case is sensitive to thermal DEIM (TDEIM). If you enable TDEIM
# (e.g. `MOR_DISABLE_TDEIM=0` when `ops/tdeim_*` is present), consider using
# `decoupled = yes` to clamp coefficients to the training ranges.
decoupled = no

[pod]
mode0 = state

[DEIM]
nbnl = 20
dumpnls = no
dumpfine = no
mode = mclsdeim
alpha = 1.e-12
