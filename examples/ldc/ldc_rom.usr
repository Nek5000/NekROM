c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0

      eps = 1.e-5
      y0 = 1.

      if (y.gt.(y0-eps)) ux = (1.-x*x)**2

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ldcpar/ dxmin

      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0

      eps = 1.e-5
      y0 = 1.

      if (y.gt.(y0-eps)) ux = (1.-x*x)**2

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat

      include 'SIZE'
      include 'TOTAL'

      xmin= 10000.
      xmax=-10000.
      ymin= 10000.
      ymax=-10000.

      one=1.
      pi=4.*atan(one)

      n1d=nint(sqrt(1.*nelgt))

      do ie=1,nelt
      do ic=1,4
c     do ic=1,2**(ldim) ! generalized in dimension
         x=xc(ic,ie)
         y=yc(ic,ie)
         if (x.lt.xmin) xmin=x
         if (x.gt.xmax) xmax=x
         if (y.lt.ymin) ymin=y
         if (y.gt.ymax) ymax=y
      enddo
      enddo

      xmin=glmin(xmin,1)
      xmax=glmax(xmax,1)

      ymin=glmin(ymin,1)
      ymax=glmax(ymax,1)

      dxi=1./(xmax-xmin)
      dyi=1./(ymax-ymin)

      eps=.001

      do ie=1,nelt
      do ic=1,4
         x=xc(ic,ie)
         y=yc(ic,ie)
         nx=nint(n1d*(x-xmin)*dxi)
         ny=nint(n1d*(y-ymin)*dyi)
         x=-1.*cos(nx*pi/n1d)
         y=-1.*cos(ny*pi/n1d)
         xc(ic,ie)=x
         yc(ic,ie)=y
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2

      include 'SIZE'
      include 'GEOM'

      call rescale_x(xm1,-1.,1.)
      call rescale_x(ym1,-1.,1.)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
