c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      ux=0.0
      uy=0.0
      uz=0.0

      temp=0.

      eps = 1.e-5
      y0 = 1.

      if (y.gt.(y0-eps)) ux = (1.-x*x)**2
      if (y.gt.(y0-eps)) temp = (1.-x*x)**2
      if (y.gt.(y0-eps)) temp =1.

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ldcpar/ dxmin

      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0

      eps = 1.e-5
      y0 = 1.

      if (y.gt.(y0-eps)) ux = (1.-x*x)**2

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat

      include 'SIZE'
      include 'TOTAL'

      real xmin(1),xmax(1),ymin(1),ymax(1)

      xmin(1)= 10000.
      xmax(1)=-10000.
      ymin(1)= 10000.
      ymax(1)=-10000.

      one=1.
      pi=4.*atan(one)

      n1d=nint(sqrt(1.*nelgt))

      do ie=1,nelt
      do ic=1,4
         x=xc(ic,ie)
         y=yc(ic,ie)
         if (x.lt.xmin(1)) xmin(1)=x
         if (x.gt.xmax(1)) xmax(1)=x
         if (y.lt.ymin(1)) ymin(1)=y
         if (y.gt.ymax(1)) ymax(1)=y
      enddo
      enddo

      xmin(1)=glmin(xmin(1),1)
      xmax(1)=glmax(xmax(1),1)

      ymin(1)=glmin(ymin(1),1)
      ymax(1)=glmax(ymax(1),1)

      dxi=1./(xmax(1)-xmin(1))
      dyi=1./(ymax(1)-ymin(1))

      eps=.001

      do ie=1,nelt
      do ic=1,4
         x=xc(ic,ie)
         y=yc(ic,ie)
         nx=nint(n1d*(x-xmin(1))*dxi)
         ny=nint(n1d*(y-ymin(1))*dyi)
         x=-1.*cos(nx*pi/n1d)
         y=-1.*cos(ny*pi/n1d)
         xc(ic,ie)=x
         yc(ic,ie)=y
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2

      include 'SIZE'
      include 'TOTAL'

      call rescale_x(xm1,-1.,1.)
      call rescale_x(ym1,-1.,1.)
      
      call fix_geom

      return
      end
