#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$NEK_SOURCE_ROOT/tools/bin:$PATH"

casename="phill"
usr_file="${casename}_fom"
lpmin="$(awk 'match($0,/parameter *\\(lpmin=([0-9]+)/,a){print a[1]; exit}' SIZE)"
lpmin="${lpmin:-1}"
np="${1:-$lpmin}" # number of MPI ranks to use for the FOM (see SIZE lpmin)
if [ "$np" -lt "$lpmin" ]; then
    echo "ERROR: ${casename} requires np >= ${lpmin} (from SIZE lpmin)."
    echo "Run: ./run_fom ${lpmin}"
    exit 2
fi
logfile=${casename}.log.$np

makerom "$usr_file"

# Build the initial box mesh and map if needed.
if [ ! -f "${casename}.re2" ]; then
    genbox << EOF
${casename}.box
EOF
    cp -f box.re2 "${casename}.re2"
fi

genmap << EOF
${casename}
0.1
EOF

echo 'running Nek5000 FOM calculation...'
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' "$casename" "$script_dir" > SESSION.NAME
    ./nek5000 > "$logfile"
else
    neklmpi "$casename" "$np"
fi

mkdir -p snaps
if compgen -G "*${casename}0.f*" > /dev/null; then
    mv *${casename}0.f* snaps
fi
mv "$logfile" snaps
ls -r snaps/${casename}0.f* > file.list

echo 'done with FOM, exiting...'
