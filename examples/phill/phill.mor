[GENERAL]
mode    = off # (off=offline,on=online,all=both,onb=online with bases,cp)
field   = v   # fields to perform the pod-rom (v=vel.,t=temp.,vt=both)
nb      = 2   # number of modes for the pod-rom (excluding mean)
ns      = 2   # number of snapshots to use (must be <= entries in file.list)

[POD]
type     = h10 # pod-inner product (l2,h10,hlm)
mode0    = avg # 0th mode of the POD basis (avg=mean(snaps),state=vx,vy,vz,t)

[QOI]
freq = 0   # frequency of qoi dump (<1 -> iostep)
tke  = no  # turbulence kinetic energy
drag = no  # drag based on OBJ data
nu   = 0   # nusselt number based on problem type (1-3)

[DEIM]
nbnl    = 2        # number of nonlinear (convection) POD-bases
dumpnls = yes      # whether or not to dump the non-linear snapshots
mode    = clsdeim  # embedded DEIM-family runtime path
