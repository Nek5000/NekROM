#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

np="${1:-1}"
casename="u3_t020_n13"
usr_file="$casename"
logfile="${casename}.log.${np}"

genmap << EOF
$casename
0.1
EOF

makerom "$usr_file"

echo 'running Nek5000 FOM calculation...'
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' "$casename" "$script_dir" > SESSION.NAME
    ./nek5000 > "$logfile"
else
    neklmpi "$casename" "$np"
fi

snaps_dir="snaps"
mkdir -p "$snaps_dir"
mv *${casename}0.f* "$logfile" "$snaps_dir"
ls -r "$snaps_dir"/${casename}0.f* > file.list

if grep ' egn' "$snaps_dir/$logfile" > fom.egn.dat; then
    :
else
    : > fom.egn.dat
fi

echo 'done with FOM, exiting...'
