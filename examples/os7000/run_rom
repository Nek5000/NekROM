#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

np="${1:-1}"
casename="u3_t020_n13"
usr_file="${casename}_rom"
snaps_dir="snaps"
logfile="${casename}_rom.log.${np}"
deim_nbnl="${NEKROM_DEIM_NBNL:-20}"

if ! compgen -G "$snaps_dir/${casename}0.f*" > /dev/null; then
    echo "No FOM snapshots found under $snaps_dir/. Run ./run_fom first." >&2
    exit 1
fi

ls -r "$snaps_dir"/${casename}0.f* > file.list

if [ ! -f LMOR ]; then
    cp "$MOR_DIR/templates/LMOR.template" LMOR
fi
sed "s/parameter (lbnl=[0-9][0-9]*)/parameter (lbnl=${deim_nbnl})/" LMOR > LMOR.tmp
mv LMOR.tmp LMOR

genmap << EOF
$casename
0.1
EOF

makerom "$usr_file"

echo 'running Nek5000 ROM calculation...'
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' "$casename" "$script_dir" > SESSION.NAME
    ./nek5000 > "$logfile"
else
    neklmpi "$casename" "$np"
    mpi_log="${casename}.log.${np}"
    if [ -f "$mpi_log" ]; then
        mv "$mpi_log" "$logfile"
    fi
fi

mkdir -p "$snaps_dir"
mv *${casename}0.f* "$snaps_dir"
mv "$logfile" "$snaps_dir"

if grep ' egn' "$snaps_dir/$logfile" > rom.egn.dat; then
    :
else
    : > rom.egn.dat
fi

echo 'done with ROM, exiting...'
