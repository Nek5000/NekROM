[GENERAL]
mode    = on # embedded online ROM path using precomputed operators
field   = v  # fields to perform the pod-rom (v=vel.,t=temp.,vt=both)
nb      = 20  # number of modes for the pod-rom
ns      = 80  # number of snapshots available in ops/

[POD]
type     = h10 # pod-inner product (l2,h10,hlm)
mode0    = avg # 0th mode of the POD basis (avg=mean(snaps),state=vx,vy,vz,t)

[QOI]
freq = 10 # frequency of qoi dump (<1 -> iostep)
tke  = no # turbulence kinetic energy
drag = no # drag based on OBJ data
nu   = 0  # nusselt number based on problem type (1-3)

[DEIM]
nbnl = 20 # number of nonlinear (convection) POD-bases
dumpnls = yes # whether or not to dump the non-linear snapshots
dumpfine = yes # dump convection snapshots and cba files on the fine grid
mode = mclsdeim # default embedded DEIM-family runtime path
alpha = 1.0e-12 # regularization strength for MCLSDEIM
