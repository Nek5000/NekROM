c-----------------------------------------------------------------------
       subroutine userchk
       include 'SIZE'
       include 'TOTAL'

       parameter(lt=lx1*ly1*lz1*lelv)
       real vort(lt,3),work1(lt),work2(lt)

       ntot = nx1*ny1*nz1*nelv
       umax = glamax(vx,ntot)
       if (umax.gt.8.) then
          write(6,*) nid,' umax:',umax,ntot
          call emerxit
       endif

       call comp_vort3(vort,work1,work2,vx,vy,vz)
       vmax = glamax(vort,ntot)
       if (nid.eq.0) write(6,1) istep, time, vmax
    1  format(i9,1p2e14.6,' peak vorticity')

       ifto = .true.
       call copy(t,vort,ntot)  ! Dump vorticity in place of Temperature

       return
       end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,iel)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,iel)
      include 'SIZE'
      include 'TSTEP'
      include 'NEKUSE'

      integer icalld
      save    icalld
      data    icalld  /0/

      real rhol,delta
      save rhol,delta

      ux=0.0
      uy=0.0
      uz=0.0
      TEMP=0
c
c
c     Shu's double shear layer (p.65, 1997 ICASE Rep.)
c
c     Also,
c
c         Bell, Collela, & Glaz, JCP [85],  p257 (1989)
c         Brown and Minion,      JCP [122], p165 (1995)
c         Tadmor                 1997, Italy
c
c
c     THIS SETUP FOLLOWS R.B. Klein and B. Sanderse, 2024 JCP, p.14

      delta = pi/15
      epsln = 0.05

      if (icalld.eq.0) then
         icalld = 1
         if (nid.eq.0) write(6,*) 'Shear layer delta:',delta
         if (nid.eq.0) write(6,*) 'Shear layer epsln:',epsln
      endif

      arg = (y-pi/2)/delta
      if (y.gt.pi) arg = (1.5*pi-y)/delta

      ux = tanh(arg)
      uy = epsln*sin(x)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      x0=0
      x1=2*pi
      call rescale_x(xm1,x0,x1)  ! 0 to 2pi in both directions
      call rescale_x(ym1,x0,x1)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      include 'SIZE'
      include 'TOTAL'

c     THIS SETUP FOLLOWS R.B. Klein and B. Sanderse, 2024 JCP, p.15

      density   = 1.0
      viscosity = .001 

      param(1)   = density
      param(2)   = viscosity

      cpfld(1,1) = viscosity  ! Constant property field values
      cpfld(1,2) = density    ! must also be set :/

      return
      end
c-----------------------------------------------------------------------
