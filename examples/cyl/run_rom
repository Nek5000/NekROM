#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

casename="cyl"
np="${1:-1}"
makerom "${casename}_rom"
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' "$casename" "$script_dir" > SESSION.NAME
    ./nek5000 > "${casename}.log.${np}"
else
    neklmpi "$casename" "$np"
fi

logfile=${casename}.log.${np}

snaps_dir="snaps"
mkdir -p "$snaps_dir"
if compgen -G "*${casename}0.f*" > /dev/null; then
    mv *${casename}0.f* "$snaps_dir"
fi
mv "$logfile" "$snaps_dir"

# The detail computation of drag in the ROM is in Kento Kaneko An Augmented Basis Method for Reduced Order Models of Turbulent Flow. Ph.D. thesis (2022).
logpath="$snaps_dir/$logfile"
if grep dragx "$logpath" | sed 's/dragx//g' > rom.dragx.dat && [ -s rom.dragx.dat ]; then
    :
elif [ -f qoi/rdgx ]; then
    cp qoi/rdgx rom.dragx.dat
else
    : > rom.dragx.dat
fi

if grep dragy "$logpath" | sed 's/dragy//g' > rom.dragy.dat && [ -s rom.dragy.dat ]; then
    :
elif [ -f qoi/rdgy ]; then
    cp qoi/rdgy rom.dragy.dat
else
    : > rom.dragy.dat
fi
