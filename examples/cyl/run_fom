#!/bin/bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

MOR_DIR="${MOR_DIR:-$(cd "$script_dir/../.." && pwd)}"
NEK_SOURCE_ROOT="${NEK_SOURCE_ROOT:-$(cd "$MOR_DIR/../Nek5000" && pwd)}"
export MOR_DIR NEK_SOURCE_ROOT
export NEK_DEPS_LOCAL_SRC="${NEK_DEPS_LOCAL_SRC:-1}"
export PATH="$MOR_DIR/bin:$NEK_SOURCE_ROOT/bin:$PATH"

np="${1:-1}" # number of processors to use for FOM calculation
makerom cyl_fom # makerom is required so the MOR include files are linked in

# generate mesh connectivity information
genmap << EOF
cyl
0.1
EOF

echo 'running Nek5000 FOM calculation...'
logfile=cyl.log.$np
if [ "$np" -eq 1 ]; then
    printf '%s\n%s/\n' cyl "$script_dir" > SESSION.NAME
    ./nek5000 > "$logfile"
else
    neklmpi cyl "$np"
fi

mkdir -p snaps
mv *cyl0.f* "$logfile" snaps
ls -r snaps/cyl0.f* > file.list

# For the current case, we have Re=100. The drag and lift coefficients are also computed by calls in userchk.
if grep dragx snaps/"$logfile" | sed 's/dragx//g' > fom.dragx.dat && [ -s fom.dragx.dat ]; then
    :
elif [ -f qoi/rdgx ]; then
    cp qoi/rdgx fom.dragx.dat
else
    : > fom.dragx.dat
fi

if grep dragy snaps/"$logfile" | sed 's/dragy//g' > fom.dragy.dat && [ -s fom.dragy.dat ]; then
    :
elif [ -f qoi/rdgy ]; then
    cp qoi/rdgy fom.dragy.dat
else
    : > fom.dragy.dat
fi

echo 'done with FOM, exiting...'
